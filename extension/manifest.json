{
  "manifest_version": 3,
  "name": "Пора домой — время в пути",
  "version": "1.3.1",
  "version_name": "1.3.1 beta",
  "description": "Время от работы до дома из Яндекс Карт. Фоновое обновление без открытой вкладки и API-ключа.",
  "permissions": [
    "storage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://yandex.ru/maps/*",
    "https://www.yandex.ru/maps/*",
    "https://yandex.ru/map-widget/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Пора домой",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://yandex.ru/maps/*",
        "https://www.yandex.ru/maps/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://yandex.ru/map-widget/v1/*"
      ],
      "js": [
        "core.js",
        "widget.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
